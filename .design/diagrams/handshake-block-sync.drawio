  <diagram id="ghost-sync-page" name="Ghost Sync">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g-title" value="SPV / ghost-chain sync" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g-a" value="SPV peer sends&#xa;GhostChainRequest&#xa;(latest id, hash, fork id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-b" value="Remote process_ghost_chain_request()&#xa;loads peer key list and computes&#xa;last shared ancestor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-c" value="generate_ghost_chain()&#xa;builds parallel vectors for prehashes,&#xa;prev hashes, ids, timestamps, txs, gts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="110" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-d" value="GhostChainSync returned to SPV peer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1050" y="120" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-e" value="process_ghost_chain()&#xa;reconstructs each block hash from&#xa;previous_block_hash + prehash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-f" value="If txs[i] is true&#xa;queue full block fetch in&#xa;BlockchainSyncState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="290" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-g" value="If txs[i] is false&#xa;add ghost block directly to blockchain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="290" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-h" value="After loop&#xa;trigger reorg from lowest affected point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="470" width="280" height="80" as="geometry" />
        </mxCell>
