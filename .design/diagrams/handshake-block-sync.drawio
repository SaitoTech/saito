  <diagram id="handshake-page" name="Handshake">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="h-title" value="Handshake flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-a" value="Incoming or outgoing transport&#xa;socket established" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="h-b" value="NetworkPeer decides role&#xa;Incoming: send challenge&#xa;Outgoing: wait for challenge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h-c" value="HandshakeChallenge / HandshakeResponse&#xa;carry signature, versions, services,&#xa;endpoint, block_fetch_url, next challenge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="90" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h-d" value="process_handshake_response()&#xa;verifies signature against stored challenge&#xa;and stores peer metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="90" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h-e" value="If verifier is incoming side,&#xa;send final HandshakeResponse&#xa;signed over responder challenge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="240" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h-f" value="Emit PeerConnectionResult&#xa;RoutingThread queues new_peers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h-g" value="Peer::handle_new_peer()&#xa;promotes response into durable Peer&#xa;and emits PeerHandshakeComplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h-h" value="Bootstrap next step&#xa;Empty chain: GenesisBlockRequest&#xa;Otherwise: request_blockchain_from_peer()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="300" height="90" as="geometry" />
