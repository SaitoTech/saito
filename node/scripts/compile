#!/bin/bash

echo "Builing Lite Client ($1 $2)"
echo ""

echo "  Updating build number in options file"
currentTime=$(date +%s)
echo "  Current Timestamp: $currentTime"


buildJsonFile="./config/build.json"

if [ ! -f "$buildJsonFile" ]; then
    echo "  build.json not found, creating file..."
    mkdir -p ./config
    echo '{"build_number": "0"}' > "$buildJsonFile"
fi

echo ""
echo "  Ensuring minimal config files available"
echo ""

[ ! -f ./config/options.conf ] && cp ./config/.template.options.conf ./config/options.conf
[ ! -f ./config/modules.config.js ] && cp ./config/.template.modules.config.js ./config/modules.config.js


echo ""
echo "  Consolidating CSS files"
echo ""

# Parse modules from modules.config.js lite section
function get_lite_module_paths {
  PMOD=0
  declare -a MODULE_PATHS
  
  input="./config/modules.config.js"
  #echo "DEBUG: Reading from $input" >&2
  while IFS= read -r line
  do
    if [[ $line == *"lite:"* ]]; then
      echo "DEBUG: Found lite section on line: $line" >&2
      PMOD=1
      continue
    fi
    
    if [[ $PMOD == 1 ]]; then
      #echo "DEBUG: Read line while PMOD=1: $line" >&2
      # Check for end of array - look for standalone ] or ],
      if [[ $line =~ ^[[:space:]]*\] ]]; then
        #echo "DEBUG: Found end of lite section" >&2
        break
      fi
      
      # Skip commented lines (lines where // appears before any quotes)
      trimmed_line=$(echo "$line" | sed 's/^[[:space:]]*//')
      if [[ $trimmed_line == "//"* ]]; then
        #echo "DEBUG: Skipping commented line: $line" >&2
        continue
      fi
      
      # Extract the module path from the line
  #    echo "DEBUG: Processing line: $line" >&2
      # Extract content between quotes: 'path' or "path"
      MODULE_PATH=$(echo "$line" | sed -n "s/.*['\"]\\([^'\"]*\\)['\"].*/\\1/p")
  #    echo "DEBUG: Extracted path: '$MODULE_PATH'" >&2
      if [[ -n "$MODULE_PATH" ]] && [[ "$MODULE_PATH" != *"["* ]] && [[ "$MODULE_PATH" != *"{"* ]]; then
   #     echo "DEBUG: Found module path: $MODULE_PATH" >&2
        MODULE_PATHS+=("$MODULE_PATH")
      else
        echo "DEBUG: Rejected path: '$MODULE_PATH'" >&2
         echo "--"
      fi
    fi
  done < "$input"
  
# echo "DEBUG: Total modules found: ${#MODULE_PATHS[@]}" >&2
  echo "${MODULE_PATHS[@]}"
}

LITE_MODULES=($(get_lite_module_paths))

#echo "DEBUG: Processing ${#LITE_MODULES[@]} modules" >&2

for modpath in "${LITE_MODULES[@]}"; do
  # Get the directory containing the module
  moddir=$(echo "$modpath" | sed 's/\/[^/]*$//')
  moddir="./mods/$moddir"

  #echo "DEBUG: Processing module path: $modpath -> directory: $moddir" >&2
  
  if [ -d "$moddir"/web/css ]; then
    if [ "$1" == "dev" ] || [ "$2" == "dev" ]; then
      echo "link module css in $moddir"
      find "$moddir"/web/css/ -type f -name '*.css' 2>/dev/null | sed 's/.*web\///' | sed 's/^/@import url(".\//' | sed 's/$/");/' | sed 's/\/\//\//g' > "$moddir"/web/style.css 
    else
      echo "compile module css in $moddir"
      echo "/**/" > "$moddir"/web/style.css
      echo "/* THIS FILE AUTOGENERATED FROM CSS in ./web/css/ */ " >> "$moddir"/web/style.css
      echo "/**/" >> "$moddir"/web/style.css
      find "$moddir"/web/css -type f -name '*.css'  -exec cat {} \; >> "$moddir"/web/style.css
    fi
  fi
done

echo ""

if [ "$1" == "dev" ] || [ "$2" == "dev" ]; then
  echo "linking game-*.css files into game.css"
  find ./web/saito/ -type f -name 'game-*.css' | sed 's/\.\/web/@import url("/' | sed 's/$/");/' > ./web/saito/game.css
  echo "linking saito-*.css files into saito.css"
  find ./web/saito/ -type f -name 'saito-*.css' | sed 's/\.\/web/@import url("/' | sed 's/$/");/' > ./web/saito/saito.css
  echo "@import url(\"/saito/css-imports/xclose.css\");" >> ./web/saito/saito.css;   
else
  echo "compiling game-*.css files into game.css"
  echo "/**/" > ./web/saito/game.css
  echo "/* THIS FILE AUTOGENERATED FROM CSS in saito/css-includes/ / */ " >> ./web/saito/game.css
  echo "/**/" >> ./web/saito/game.css
  find ./web/saito/ -type f -name 'game-*.css' -exec cat {} \; >> ./web/saito/game.css
  echo "compiling saito-*.css files into saito.css"
  echo "/**/" > ./web/saito/saito.css
  echo "/* THIS FILE AUTOGENERATED FROM CSS in saito/css-includes/ / */ " >> ./web/saito/saito.css
  echo "/**/" >> ./web/saito/saito.css
  find ./web/saito/ -type f -name 'saito-*.css' -exec cat {} \; >> ./web/saito/saito.css
  cat ./web/saito/css-imports/xclose.css >> ./web/saito/saito.css
fi




echo ""
echo "CSS complete"
echo ""

if [ "$1" == "dev" ] || [ "$2" == "dev" ]; then
  echo ""
  echo "Dev build - don't update build number"
  echo ""
else 
  echo ""
  echo "Updating Build Number"
  currentTime=$(date +%s)
  echo '{"build_number": "'$currentTime'"}' > ./config/build.json
  cat ./config/build.json | sed 's/_/\ /' | sed 's/[{}"]//g'
  echo ""
fi


function post_compile {

  cp ./lib/saito/boot.js ./web/saito/saito2.js
  cat ./web/saito/saito.js >> ./web/saito/saito2.js
  mv -f ./web/saito/saito2.js ./web/saito/saito.js

  echo -e "\ndone!"
}

function reset_bundler {

echo "Resetting Saito to Default Modules!"
echo ""

  rm -rf ./bundler
  if [ ! -d "./bundler" ]; then

    mkdir -p bundler/default/mods
    mkdir -p data/blocks
    cp -rf ./lib bundler/default/lib
    rm -f bundler/default/lib/saito/*.spec.js
    rm -f bundler/default/lib/saito/core/*.spec.js
    cp -rf ./config bundler/default/config
    cp -rf ./apps bundler/default/apps

    copy_lite_mods_to_bundler_directory

echo ""
echo "Compiling Lite-Client JS..."

    rm -rf bundler/default/mods/devtools/bundler/dist

    for md in bundler/default/mods/* ; do
      rm -rf "$md/web"
      rm -rf "$md/sql"
      rm -rf "$md/www"
      rm -rf "$md/src"
      rm -rf "$md/docs"
      rm -rf "$md/compile"
      rm -rf "$md/DESCRIPTION.txt"
      rm -rf "$md/BUGS.txt"
      rm -rf "$md/README.txt"
      rm -rf "$md/*.md"
      rm -rf "$md/README.md"
      rm -rf "$md/install.sh"
      rm -rf "$md/license"
    done
  fi

}

function reset_nonpersistent {

  mkdir -p data/blocks

  # ensure deleted
  rm -f ./web/saito/saito.js

  # backup dbs before deleting anything
  mkdir -p ./data/backup
  cp -v ./data/*.sq3 ./data/backup/

  # we explicitly don't delete registry/balance databases
  rm -f ./data/devtools.sq3
  rm -f ./data/log.txt
  rm -f ./data/*.sq3-journal
  find ./data/blocks/ -name '*.sai' | xargs rm -r
  rm -f ./data/shashmaps/*.smap
  rm -f ./data/blocks/*.zip
  rm -f ./data/blocks/*.segadd
  rm -f ./data/tmp/*.sai
  rm -f ./data/tmp/*.zip
  rm -f ./config/options
  rm -f ./data/peer_state.txt

  rm -rf ./mods/devtools/mods
  mkdir ./mods/devtools/mods
  #
  # do not delete compiled software
  #
  # rm -rf ./mods/devtools/bundler/dist/

  rm -f ./mods/devtools/mods/*
  rm -rf ./mods/devtools/bundler/mods/*
  rm -rf ./mods/devtools/bundler/dist/*
  rm -f ./mods/devtools/bundler/*.js
  rm -f ./mods/devtools/bundler/*.json
  rm -f ./logs/*

  #let the system know that users pre-existed a reset.
  if [ -f ./data/rewards.sq3 ]; then
  echo "update users set latest_tx = -1;" | sqlite3 ./data/rewards.sq3
  fi

  if [ -f ./config/options.conf ]; then
    echo "creating options file"
    cp ./config/options.conf ./config/options
  else
    cp ./config/.templates.options.conf ./config/options
  fi
}

function reset_persistent {

  # backup dbs before deleting anything
  mkdir -p ./data/backup
  cp -v ./data/*.sq3 ./data/backup/

  #rm -f ./data/archive.sq3
  rm -f ./data/memento.sq3
  #rm -f ./data/warehouse.sq3
  #rm -f ./data/warehousex.sq3
  rm -f ./data/assetstore.sq3
  rm -f ./data/registry.sq3
  rm -f ./data/league.sq3
  rm -f ./web/client.options
  rm -f ./data/blocks/*

  mkdir -p data/blocks

}

function copy_lite_mods_to_bundler_directory {

  PMOD=0
  declare -a ARRAY_OF_MODS

  input="./config/modules.config.js"
  while IFS= read -r line
  do
    if [[ $line == *"lite:"* ]]; then
      PMOD=1
      continue
    fi
    
    if [[ $PMOD == 1 ]]; then
      # Check for end of array - look for standalone ] or ],
      if [[ $line =~ ^[[:space:]]*\] ]]; then
        break
      fi
      
      # Skip commented lines
      if [[ $line == *"//"* ]]; then
        continue
      fi
      
      # Extract the full module path from the line
      # Extract content between quotes: 'path' or "path"
      MODULE_PATH=$(echo "$line" | sed -n "s/.*['\"]\\([^'\"]*\\)['\"].*/\\1/p")
      if [[ -n "$MODULE_PATH" ]] && [[ "$MODULE_PATH" != *"["* ]] && [[ "$MODULE_PATH" != *"{"* ]]; then
        ARRAY_OF_MODS+=("$MODULE_PATH")
      fi
    fi
  done < "$input"

  #printf '%s\n' "${ARRAY_OF_MODS[@]}"

  for modpath in "${ARRAY_OF_MODS[@]}"; do
    # Get the directory containing the module file
    moddir=$(dirname "$modpath")
    
    echo "installing mod for lite-client bundling: $modpath";
    
    # Handle both mods/* and ../usermods/* paths
    if [[ $modpath == ../* ]]; then
      # For paths like ../usermods/richardp/settlers/settlers.js
      # Extract the relative path after ../usermods/
      relative_path="${moddir#../usermods/}"
      source_dir="./mods/$moddir"
      target_dir="bundler/default/mods/$relative_path"
      mkdir -p "$(dirname "$target_dir")"
      echo "pwd: $(pwd)"
      echo "source_dir: $source_dir"
      echo "target_dir: $target_dir"
      cp -rf "$source_dir" "$target_dir"
    else
      # For paths like poker/poker.js (relative to mods/)
      # Copy from ./mods/poker to bundler/default/mods/poker
      source_dir="./mods/$moddir"
      modname=$(basename "$moddir")
      target_dir="bundler/default/mods/$modname"
      mkdir -p "bundler/default/mods"
      cp -rf "$source_dir" "$target_dir"
    fi
  done

  rm -f ./bundler/default/mods/devtools/mods/*
  rm -f ./bundler/default/mods/devtools/bundler/*
  rm -f ./bundler/default/mods/devtools/dist/*

}


if [ "$1" == "nuke" ]; then

  echo ""
  echo ""
  echo "     _.-^^---....,,--        "
  echo " _--                  --_    "
  echo " <                        >) "
  echo " |                         | "
  echo "  \._                   _./  "
  echo "     '''--. . , ; .--'''     "
  echo "          | |   |            "
  echo "       .-=||  | |=-.         "
  echo "        -=#$%&%$/=-'         "
  echo "          | ;  :|            "
  echo "      .,-#%&$/#@%#&#~,         "
  echo "  -------------------------  "
  echo "  NUKING YOUR SAITO INSTALL  "
  echo "  -------------------------  "
  echo "  (resetting configuration)  "
  echo ""
  echo ""

  rm -rf built/*
  tsc -p ./build/tsconfig.json
  reset_nonpersistent
  reset_persistent
  reset_bundler


  time node build/webpack.config.cjs $2 $3

  post_compile

fi

if [ "$1" == "reset" ] || [ "$1" == "dev" ]; then

  echo ""
  echo ""
  echo "  --------------------------  "
  echo "  RESETTING ALL BUT CORE DATA "
  echo "  --------------------------  "
  echo "   (resetting blockchain)  "
  echo ""
  echo ""

  tsc -p ./build/tsconfig.json

  reset_nonpersistent
  reset_bundler
  
  time node build/webpack.config.cjs $2 $3
  
  post_compile

fi

if [ "$1" == "recompile" ]; then

  echo ""
  echo "  -------------------------  "
  echo "   RE-COMPILING JAVASCRIPT   "
  echo "  -------------------------  "
  echo "  (resetting configuration)  "
  echo ""
  echo ""

  # making sure we have some modules defined.


  reset_bundler

  time node build/webpack.config.cjs $2 $3

  post_compile


fi




