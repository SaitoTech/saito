#!/bin/bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

echo "Builing Lite Client ($1 $2)"
echo ""

echo "  Updating build number in options file"
currentTime=$(date +%s)
echo "  Current Timestamp: $currentTime"

buildJsonFile="${PROJECT_DIR}/dist/build.json"

if [ ! -f "$buildJsonFile" ]; then
    echo "  build.json not found, creating file..."
    mkdir -p "${PROJECT_DIR}/dist"
    echo '{"build_number": "0"}' > "$buildJsonFile"
fi

# make sure blocks directory exists
mkdir -p "${PROJECT_DIR}/data/blocks"

# make sure state directory exists
mkdir -p "${PROJECT_DIR}/data/state"

echo ""
echo "  Ensuring minimal config files available"
echo ""

[ ! -f "${PROJECT_DIR}/config/options.conf" ] && cp "${PROJECT_DIR}/config/.template.options.conf" "${PROJECT_DIR}/config/options.conf"
[ ! -f "${PROJECT_DIR}/config/modules.config.js" ] && cp "${PROJECT_DIR}/config/.template.modules.config.js" "${PROJECT_DIR}/config/modules.config.js"


echo ""
echo "  Consolidating CSS files"
echo ""

for d in "${PROJECT_DIR}/mods/"*/ ;
do
  if [ -d "$d/web/css" ]; then
    if [ "$1" == "dev" ] || [ "$2" == "dev" ]; then
      echo "link module css in $d"
      find "$d/web/css/" -type f -name '*-base.css' 2>/dev/null | sort | sed 's|.*/web/||' | sed 's/^/@import url(".\//' | sed 's/$/");/' | sed 's/\/\//\//g' > "$d/web/style.css"
      find "$d/web/css/" -type f -name '*.css' ! -name '*-base.css' 2>/dev/null | sort | sed 's|.*/web/||' | sed 's/^/@import url(".\//' | sed 's/$/");/' | sed 's/\/\//\//g' >> "$d/web/style.css"
    else
      echo "compile module css in $d"
      echo "/**/" > "$d/web/style.css"
      echo "/* THIS FILE AUTOGENERATED FROM CSS in ./web/css/ */ " >> "$d/web/style.css"
      echo "/**/" >> "$d/web/style.css"
      find "$d/web/css" -type f -name '*-base.css' -exec cat {} \; >> "$d/web/style.css"
      find "$d/web/css" -type f -name '*.css' ! -name '*-base.css' -exec cat {} \; >> "$d/web/style.css"
    fi
  fi
done

echo ""

if [ "$1" == "dev" ] || [ "$2" == "dev" ]; then
  echo "linking game-*.css files into game.css"
  find "${PROJECT_DIR}/web/saito/" -type f -name 'game-*.css' | sed 's|.*/web|@import url("|' | sed 's/$/");/' > "${PROJECT_DIR}/web/saito/game.css"
  echo "linking saito-*.css files into saito.css"
  find "${PROJECT_DIR}/web/saito/" -type f -name 'saito-*.css' | sed 's|.*/web|@import url("|' | sed 's/$/");/' > "${PROJECT_DIR}/web/saito/saito.css"
  echo "@import url(\"/saito/css-imports/xclose.css\");" >> "${PROJECT_DIR}/web/saito/saito.css"
else
  echo "compiling game-*.css files into game.css"
  echo "/**/" > "${PROJECT_DIR}/web/saito/game.css"
  echo "/* THIS FILE AUTOGENERATED FROM CSS in saito/css-includes/ / */ " >> "${PROJECT_DIR}/web/saito/game.css"
  echo "/**/" >> "${PROJECT_DIR}/web/saito/game.css"
  find "${PROJECT_DIR}/web/saito/" -type f -name 'game-*.css' -exec cat {} \; >> "${PROJECT_DIR}/web/saito/game.css"
  echo "compiling saito-*.css files into saito.css"
  echo "/**/" > "${PROJECT_DIR}/web/saito/saito.css"
  echo "/* THIS FILE AUTOGENERATED FROM CSS in saito/css-includes/ / */ " >> "${PROJECT_DIR}/web/saito/saito.css"
  echo "/**/" >> "${PROJECT_DIR}/web/saito/saito.css"
  find "${PROJECT_DIR}/web/saito/" -type f -name 'saito-*.css' -exec cat {} \; >> "${PROJECT_DIR}/web/saito/saito.css"
  cat "${PROJECT_DIR}/web/saito/css-imports/xclose.css" >> "${PROJECT_DIR}/web/saito/saito.css"
fi




echo ""
echo "CSS complete"
echo ""

mkdir -p "${PROJECT_DIR}/dist/ts" "${PROJECT_DIR}/dist/dyn" "${PROJECT_DIR}/dist/bundler"

if [ "$1" == "dev" ] || [ "$2" == "dev" ]; then
  echo ""
  echo "Dev build - don't update build number"
  echo ""
else 
  echo ""
  echo "Updating Build Number"
  currentTime=$(date +%s)
  echo '{"build_number": "'$currentTime'"}' > "${PROJECT_DIR}/dist/build.json"
  cat "${PROJECT_DIR}/dist/build.json" | sed 's/_/\ /' | sed 's/[{}"]//g'
  echo ""
fi


function post_compile {

  cp "${PROJECT_DIR}/lib/saito/boot.js" "${PROJECT_DIR}/web/saito/saito2.js"
  cat "${PROJECT_DIR}/web/saito/saito.js" >> "${PROJECT_DIR}/web/saito/saito2.js"
  mv -f "${PROJECT_DIR}/web/saito/saito2.js" "${PROJECT_DIR}/web/saito/saito.js"

  echo -e "\ndone!"
}

function reset_bundler {

echo "Resetting Saito to Default Modules!"
echo ""

  rm -rf "${PROJECT_DIR}/dist/bundler"
  if [ ! -d "${PROJECT_DIR}/dist/bundler" ]; then

    mkdir -p "${PROJECT_DIR}/dist/bundler/default/mods"
    mkdir -p "${PROJECT_DIR}/dist/bundler/default/dist"
    cp -rf "${PROJECT_DIR}/lib" "${PROJECT_DIR}/dist/bundler/default/lib"
    rm -f "${PROJECT_DIR}/dist/bundler/default/lib/saito/"*.spec.js
    rm -f "${PROJECT_DIR}/dist/bundler/default/lib/saito/core/"*.spec.js
    cp -rf "${PROJECT_DIR}/config" "${PROJECT_DIR}/dist/bundler/default/config"
    cp -rf "${PROJECT_DIR}/apps" "${PROJECT_DIR}/dist/bundler/default/apps"
    cp -rf "${PROJECT_DIR}/dist/build.json" "${PROJECT_DIR}/dist/bundler/default/dist/build.json"

    copy_lite_mods_to_bundler_directory

echo ""
echo "Compiling Lite-Client JS..."

    rm -rf "${PROJECT_DIR}/dist/bundler/default/mods/devtools/bundler/dist"

    for md in "${PROJECT_DIR}/dist/bundler/default/mods/"* ; do
      rm -rf "$md/web"
      rm -rf "$md/sql"
      rm -rf "$md/www"
      rm -rf "$md/src"
      rm -rf "$md/docs"
      rm -rf "$md/compile"
      rm -rf "$md/BUGS.txt"
      rm -rf "$md/DESCRIPTION.txt"
      rm -rf "$md/README.txt"
      rm -rf "$md/"*-dump.txt
      rm -rf "$md/*.md"
      rm -rf "$md/README.md"
      rm -rf "$md/install.sh"
      rm -rf "$md/license"
    done
  fi

}

function reset_nonpersistent {

 # ensure deleted
  rm -f "${PROJECT_DIR}/web/saito/saito.js"

  # backup dbs before deleting anything
  mkdir -p "${PROJECT_DIR}/data/backup"
  cp -v "${PROJECT_DIR}/data/"*.sq3 "${PROJECT_DIR}/data/backup/" 2>/dev/null || true

  # we explicitly don't delete registry/balance databases
  rm -f "${PROJECT_DIR}/data/devtools.sq3"
  rm -f "${PROJECT_DIR}/data/log.txt"
  rm -f "${PROJECT_DIR}/data/"*.sq3-journal
  find "${PROJECT_DIR}/data/blocks/" -name '*.sai' -delete 2>/dev/null || true
  rm -f "${PROJECT_DIR}/data/shashmaps/"*.smap
  rm -f "${PROJECT_DIR}/data/blocks/"*.zip
  rm -f "${PROJECT_DIR}/data/blocks/"*.segadd
  rm -f "${PROJECT_DIR}/data/tmp/"*.sai
  rm -f "${PROJECT_DIR}/data/tmp/"*.zip
  rm -f "${PROJECT_DIR}/config/options"
  rm -f "${PROJECT_DIR}/data/peer_state.txt"

  rm -rf "${PROJECT_DIR}/mods/devtools/mods"
  mkdir "${PROJECT_DIR}/mods/devtools/mods"
  #
  # do not delete compiled software
  #
  # rm -rf ${PROJECT_DIR}/mods/devtools/bundler/dist/

  rm -f "${PROJECT_DIR}/mods/devtools/mods/"*
  rm -rf "${PROJECT_DIR}/mods/devtools/bundler/mods/"*
  rm -rf "${PROJECT_DIR}/mods/devtools/bundler/dist/"*
  rm -f "${PROJECT_DIR}/mods/devtools/bundler/"*.js
  rm -f "${PROJECT_DIR}/mods/devtools/bundler/"*.json
  rm -f "${PROJECT_DIR}/logs/"*

  rm -f "${PROJECT_DIR}/data/state/"*

  #let the system know that users pre-existed a reset.
  if [ -f "${PROJECT_DIR}/data/rewards.sq3" ]; then
  echo "update users set latest_tx = -1;" | sqlite3 "${PROJECT_DIR}/data/rewards.sq3"
  fi

  if [ -f "${PROJECT_DIR}/config/options.conf" ]; then
    cp "${PROJECT_DIR}/config/options.conf" "${PROJECT_DIR}/config/options"
  else
    cp "${PROJECT_DIR}/config/.templates.options.conf" "${PROJECT_DIR}/config/options"
  fi
}

function reset_persistent {

  # backup dbs before deleting anything
  mkdir -p "${PROJECT_DIR}/data/backup"
  cp -v "${PROJECT_DIR}/data/"*.sq3 "${PROJECT_DIR}/data/backup/" 2>/dev/null || true

  #rm -f ${PROJECT_DIR}/data/archive.sq3
  rm -f "${PROJECT_DIR}/data/memento.sq3"
  rm -f "${PROJECT_DIR}/data/migration.sq3"
  #rm -f ${PROJECT_DIR}/data/warehouse.sq3
  #rm -f ${PROJECT_DIR}/data/warehousex.sq3
  rm -f "${PROJECT_DIR}/data/assetstore.sq3"
  rm -f "${PROJECT_DIR}/data/store.sq3"
  rm -f "${PROJECT_DIR}/data/registry.sq3"
  rm -f "${PROJECT_DIR}/data/league.sq3"
  rm -f "${PROJECT_DIR}/web/client.options"
  rm -f "${PROJECT_DIR}/data/blocks/"*

}

function copy_lite_mods_to_bundler_directory {


  PMOD=0
  declare -a ARRAY_OF_MODS

  input="${PROJECT_DIR}/config/modules.config.js"
  while IFS= read -r line
  do
    if [[ $PMOD == 1 ]]; then
      if ! [[ $line == *"//"* ]]; then
        #SUBSTRING=$(echo $line| cut -d".*/" -f 2)
        #SUBSTRING2=$(echo $SUBSTRING| cut -d".js" -f 1)
        SUBSTRING=$(echo $line | sed 's/.*\///')
        SUBSTRING2=$(echo $SUBSTRING | sed 's/.js.*//')
        if ! [[ $SUBSTRING2 == *"]"* ]]; then
          if ! [[ $SUBSTRING2 == *"}"* ]]; then
            ARRAY_OF_MODS+=($SUBSTRING2)
          fi
        fi
      fi
    fi
    if [[ $line == *"lite"* ]]; then
      PMOD=1
    fi
  done < $input

  #printf '%s\n' "${ARRAY_OF_MODS[@]}"

  for i in "${ARRAY_OF_MODS[@]}"; do
    echo "installing mod for lite-client bundling: $i";
    cp -rf "${PROJECT_DIR}/mods/$i" "${PROJECT_DIR}/dist/bundler/default/mods/$i"
  done

  rm -f "${PROJECT_DIR}/dist/bundler/default/mods/devtools/mods/"*
  rm -f "${PROJECT_DIR}/dist/bundler/default/mods/devtools/bundler/"*
  rm -f "${PROJECT_DIR}/dist/bundler/default/mods/devtools/dist/"*

}


if [ "$1" == "nuke" ]; then

  echo ""
  echo ""
  echo "     _.-^^---....,,--        "
  echo " _--                  --_    "
  echo " <                        >) "
  echo " |                         | "
  echo "  \._                   _./  "
  echo "     '''--. . , ; .--'''     "
  echo "          | |   |            "
  echo "       .-=||  | |=-.         "
  echo "        -=#$%&%$/=-'         "
  echo "          | ;  :|            "
  echo "      .,-#%&$/#@%#&#~,         "
  echo "  -------------------------  "
  echo "  NUKING YOUR SAITO INSTALL  "
  echo "  -------------------------  "
  echo "  (resetting configuration)  "
  echo ""
  echo ""

  rm -rf "${PROJECT_DIR}/dist/ts/"*
  (cd "${PROJECT_DIR}" && tsc -p config/build/tsconfig.json)
  reset_nonpersistent
  reset_persistent
  reset_bundler


  (cd "${PROJECT_DIR}" && time node config/build/webpack.config.cjs $2 $3)

  post_compile

fi

if [ "$1" == "reset" ] || [ "$1" == "dev" ]; then

  echo ""
  echo ""
  echo "  --------------------------  "
  echo "  RESETTING ALL BUT CORE DATA "
  echo "  --------------------------  "
  echo "   (resetting blockchain)  "
  echo ""
  echo ""

  (cd "${PROJECT_DIR}" && tsc -p config/build/tsconfig.json)

  reset_nonpersistent
  reset_bundler

  (cd "${PROJECT_DIR}" && time node config/build/webpack.config.cjs $2 $3)

  post_compile

fi

if [ "$1" == "recompile" ]; then

  echo ""
  echo "  -------------------------  "
  echo "   RE-COMPILING JAVASCRIPT   "
  echo "  -------------------------  "
  echo "  (resetting configuration)  "
  echo ""
  echo ""

  # making sure we have some modules defined.


  reset_bundler

  (cd "${PROJECT_DIR}" && time node config/build/webpack.config.cjs $2 $3)

  post_compile


fi


if [ "$1" == "setupprod" ]; then

  echo ""
  echo ""
  echo "     _.-^^---....,,--        "
  echo " _--                  --_    "
  echo " <                        >) "
  echo " |                         | "
  echo "  \._                   _./  "
  echo "     '''--. . , ; .--'''     "
  echo "          | |   |            "
  echo "       .-=||  | |=-.         "
  echo "        -=#$%&%$/=-'         "
  echo "          | ;  :|            "
  echo "      .,-#%&$/#@%#&#~,         "
  echo "  -------------------------  "
  echo "  NUKING YOUR SAITO INSTALL  "
  echo "  -------------------------  "
  echo "  (resetting configuration)  "
  echo ""
  echo ""

  cp "${PROJECT_DIR}/config/options" "${PROJECT_DIR}/config/options.bk"
  rm -rf "${PROJECT_DIR}/dist/ts/"*
  (cd "${PROJECT_DIR}" && tsc -p config/build/tsconfig.json)
  reset_nonpersistent
  reset_persistent
  reset_bundler

  (cd "${PROJECT_DIR}" && time node config/build/webpack.config.cjs $2 $3)

  post_compile

  cp "${PROJECT_DIR}/data/issuance/issuance.orig" "${PROJECT_DIR}/data/issuance/issuance"
  mv "${PROJECT_DIR}/config/options.bk" "${PROJECT_DIR}/config/options"

fi

if [ "$1" == "nukelocal" ]; then
  npm run setuplocal
  exit 0
fi

if [ "$1" == "setuplocal" ]; then

  echo ""
  echo ""
  echo "     _.-^^---....,,--        "
  echo " _--                  --_    "
  echo " <                        >) "
  echo " |                         | "
  echo "  \._                   _./  "
  echo "     '''--. . , ; .--'''     "
  echo "          | |   |            "
  echo "       .-=||  | |=-.         "
  echo "        -=#$%&%$/=-'         "
  echo "          | ;  :|            "
  echo "      .,-#%&$/#@%#&#~,         "
  echo "  -------------------------  "
  echo "  NUKING YOUR SAITO INSTALL  "
  echo "  -------------------------  "
  echo "  (resetting configuration)  "
  echo ""
  echo ""

  cp "${PROJECT_DIR}/config/options" "${PROJECT_DIR}/config/options.bk"
  rm -rf "${PROJECT_DIR}/dist/ts/"*
  (cd "${PROJECT_DIR}" && tsc -p config/build/tsconfig.json)
  reset_nonpersistent
  reset_persistent
  reset_bundler

  (cd "${PROJECT_DIR}" && time node config/build/webpack.config.cjs $2 $3)

  post_compile

  cp "${PROJECT_DIR}/data/issuance/issuance.localdev" "${PROJECT_DIR}/data/issuance/issuance"
  mv "${PROJECT_DIR}/config/options.bk" "${PROJECT_DIR}/config/options"

fi



