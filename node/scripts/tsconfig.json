{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"moduleResolution": "node",
		"sourceMap": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"outDir": "../built",
		"allowJs": true,
		"resolveJsonModule": true,
		"downlevelIteration": true,
		"allowImportingTsExtensions": false ,
		"lib": [
		        "es2022"
		],
		"paths": {
  			"saito-js": ["./node_modules/saito-js"],
  			"saito-js/*": ["./node_modules/saito-js/*"]
		},
		"skipLibCheck": true,
		"moduleResolution": "node16"
	},
	"exclude": [
		"../node_modules",
		"../lib/templates",
		"../bundler",
		"../lib/saito/ui/**/*",
		"../rust"
	],
	"include": ["../lib/**/*.ts", "../scripts/start.ts"]
}
