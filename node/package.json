{
  "name": "saito",
  "version": "0.2.0",
  "description": "scalable blockchain with proper economics",
  "scripts": {
    "dev": "ts-node-dev --max_old_space_size=8144 --project config/build/tsconfig.json ./scripts/start.ts",
    "dev-server": "./scripts/compile nuke ts-node-dev && npm run dev ",
    "nukelocal": "node ./scripts/nukelocal.js",
    "setuplocal": "./scripts/compile setuplocal && npm run dev",
    "setupprod": "./scripts/compile setupprod && ./scripts/prompt-start",
    "cli": "ts-node --project config/build/tsconfig.json  ./scripts/cli.ts",
    "deserialize_block": "node ./scripts/deserialize_block.js",
    "generate-issuance": "NODE_OPTIONS='--max-old-space-size=12288' ts-node --project config/build/tsconfig.json ./scripts/gen-issuance",
    "wh": "NODE_OPTIONS='--max-old-space-size=12288' ts-node  --project config/build/tsconfig.json ./scripts/wh.ts",
    "start": "NODE_OPTIONS='--max-old-space-size=8192' ts-node -T --files --project config/build/tsconfig.json ./scripts/start.ts --",
    "init": "./scripts/.compile nuke",
    "nuke": " ./scripts/compile nuke",
    ".saito": "node ./scripts/dynmods/compile.js",
    "reset": " ./scripts/compile reset",
    "compile": " ./scripts/compile recompile",
    "linklocal": "bash scripts/link-local.sh",
    "modules": " ./scripts/modules.sh",
    "mods": " ./scripts/modules.sh",
    "old": " webpack --config ./webpack/old/.config.js",
    "test": "jest",
    "analyze": "webpack --config ./config/build/webpack.analyze.js",
    "jsdoc": "jsdoc --destination saitolitedocs lib/templates/abstractcryptomodule.js lib/templates/substratebasedcrypto.js lib/saito/wallet.js README.md",
    "pretty": "npx prettier --write .",
    "pretty:check": "npx prettier --check .",
    "go": "npm run compile dev $@ && npm run start --",
    "nettest": "bash scripts/nettest.sh",
    "options": "node ./scripts/options-tool.js",
    "options-manager": "node ./scripts/options-manager.js",
    "module-databases": "node ./scripts/module-databases.js"
  },
  "author": "Team Saito",
  "license": "SAITO",
  "homepage": "https://saito.io",
  "dependencies": {
    "@giphy/js-fetch-api": "5.8.0",
    "@mixin.dev/mixin-node-sdk": "7.4.9",
    "@multiversx/sdk-core": "13.17.2",
    "@taasfi/multicoin-address-validator": "0.5.27",
    "axios": "0.30.3",
    "base-58": "0.0.1",
    "bip39": "3.1.0",
    "blake3": "2.1.7",
    "body-parser": "1.20.6",
    "buffer-xor": "2.0.2",
    "cors": "2.8.6",
    "cropperjs": "1.6.3",
    "crypto-browserify": "3.12.1",
    "decimal.js": "10.6.0",
    "dompurify": "3.4.14",
    "express": "4.22.2",
    "fs-extra": "8.1.0",
    "html-prettify": "1.0.7",
    "html2canvas": "1.4.1",
    "identicon.js": "2.3.3",
    "jimp": "0.22.12",
    "json-bigint": "1.0.0",
    "json-tree-viewer": "0.0.2",
    "jsstore": "4.9.0",
    "lamejs": "1.2.1",
    "localforage": "1.10.0",
    "lucide-react": "0.544.0",
    "markdown-linkify": "1.0.3",
    "marked": "4.3.0",
    "node-cryptojs-aes": "0.4.0",
    "node-emoji": "1.11.0",
    "node-fetch": "2.7.0",
    "node-html-parser": "6.1.13",
    "nodemailer": "7.0.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "saito-js": "^0.3.1",
    "sanitize-html": "2.17.1",
    "sanitizer": "0.1.3",
    "screenfull": "5.2.0",
    "secp256k1": "3.8.1",
    "snarkjs": "0.7.6",
    "sqlite": "5.1.1",
    "sqlite3": "6.0.1",
    "unzipper": "0.12.5",
    "uuid-by-string": "3.0.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@types/fs-extra": "9.0.13",
    "@types/jest": "27.5.2",
    "@types/json-bigint": "1.0.4",
    "@types/node-fetch": "2.6.13",
    "@types/secp256k1": "4.0.7",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "archiver": "3.1.1",
    "babel-loader": "8.4.1",
    "babel-polyfill": "6.26.0",
    "eslint": "8.57.1",
    "image-resolver": "0.6.1",
    "jest": "27.5.1",
    "jsdoc": "4.0.5",
    "path-browserify": "1.0.1",
    "prettier": "3.9.6",
    "source-map-loader": "3.0.2",
    "stream-browserify": "3.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-jest": "27.1.5",
    "ts-loader": "9.6.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5",
    "webpack": "5.105.4",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "4.10.0",
    "webpack-merge": "5.10.0"
  },
  "overrides": {
    "ts-jest": {
      "typescript": "5.4.5"
    }
  }
}
